{
  "autoclaude": ">=0.1.0",
  "forge": { "remote": "upstream" },
  "branches": { "integration": "develop", "production": "main" },
  "branchPrefix": "bot/",
  "humans": ["maintainer-a"],
  "bootstrap": "npm ci",
  "gates": [
    { "name": "format", "check": "npx prettier --check {files}", "fix": "npx prettier --write {files}" },
    { "name": "test", "check": "npm test" },
    { "name": "migration-lint", "check": "./scripts/lint-migrations.sh {files}", "when": ["db/migrations/**"] }
  ],
  "redStep": {
    "testFiles": ["tests/**/*.test.ts", "src/**/*.test.ts"],
    "supportFiles": ["tests/helpers/**"],
    "exclude": ["tests/e2e/**"],
    "run": "npx vitest run --reporter=junit --outputFile={report} {files}",
    "result": "junit",
    "install": { "when": "package-lock.json", "run": "npm ci" }
  },
  "worktrees": { "root": ".worktrees", "copy": [".env.local"] },
  "stages": {
    "triage": { "runtime": "claude", "model": "model-small", "effort": "medium" },
    "plan": {
      "runtime": "claude",
      "model": "model-large",
      "effort": "high",
      "fallback": { "runtime": "codex", "model": "codex-model", "effort": "high" }
    },
    "planReview": {
      "runtime": "claude",
      "model": "model-large",
      "effort": "medium",
      "scorer": { "runtime": "claude", "model": "model-small", "effort": "low" }
    },
    "implement": {
      "runtime": "claude",
      "model": "model-small",
      "effort": "medium",
      "escalated": { "runtime": "claude", "model": "model-large", "effort": "high" }
    },
    "codeReview": {
      "angles": {
        "default": { "runtime": "claude", "model": "model-small", "effort": "medium" },
        "security": { "runtime": "claude", "model": "model-large", "effort": "high" }
      },
      "scorer": { "runtime": "claude", "model": "model-small", "effort": "low" },
      "parallel": 3
    }
  },
  "codeReview": { "angles": ["criteria", "bugs", "security"], "scoreThreshold": 7 },
  "planReview": { "scoreThreshold": 6 },
  "budget": {
    "claude": { "fiveHourPct": 80, "weeklyPct": 90 },
    "codex": { "fiveHourPct": 70, "weeklyPct": 85 }
  },
  "triage": { "since": "2026-11-01", "optInLabel": "agent-triage", "maxPerDay": 10, "at": "06:00" },
  "queue": { "ready": "agent-ready", "priority": ["priority: critical", "priority: high"] },
  "automerge": { "enabled": true, "label": "automerge-dev", "categories": ["bug"], "method": "squash" },
  "humanApproval": [{ "paths": ["db/migrations/**"], "label": "agent-migration-ok" }],
  "labelRules": [
    { "when": ["src/ui/**"], "unless": ["src/ui/**/*.test.ts"], "label": "review:ui", "suppressedBy": "review:skip-ui" }
  ],
  "labels": {
    "working": "agent-working",
    "blocked": "agent-blocked",
    "needsShaping": "needs-shaping",
    "fixRound": "agent-fix-",
    "reviewRetry": "agent-retry-"
  },
  "requiredChecks": ["test", "build"],
  "forbiddenPaths": [".github/workflows/**", ".autoclaude/**"],
  "policyAdjacentPaths": ["src/auth/**"],
  "policyAdjacentReason": "authentication code needs a human decision",
  "fence": { "allow": ["npm run"] },
  "caps": {
    "concurrency": { "day": 1, "night": 2 },
    "fixRounds": 2,
    "reviewRetries": 2,
    "planRounds": 2,
    "issuesPerNight": 5,
    "wallClockMinutesPerStage": 60,
    "openPullRequests": 4,
    "staleClaimHours": 2,
    "maxTurnsPerStage": 150
  },
  "schedule": {
    "timezone": "Europe/Berlin",
    "profiles": { "day": { "from": "08:00", "to": "20:00" }, "nightStopsTakingWorkAt": "05:00" }
  },
  "messages": { "footer": "Generated by autoclaude", "defuseMentions": true }
}
